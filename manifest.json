{
  "name": "Digital Footprint Eraser",
  "short_name": "DFE",
  "description": "Ultimate privacy protection tool - Remove cookies, data brokers, and optimize social media privacy. 100% local processing.",
  "version": "1.0.0",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#0f172a",
  "theme_color": "#6366f1",
  "lang": "en-US",
  "dir": "ltr",
  "categories": ["privacy", "security", "utilities", "productivity"],
  "icons": [
