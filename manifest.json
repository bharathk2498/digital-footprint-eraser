      "purpose": "any"
    },
    {
      "src": "assets/images/icon-512x512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "assets/images/screenshot-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Digital Footprint Eraser - Desktop View"
    },
    {
      "src": "assets/images/screenshot-mobile.png",
      "sizes": "375x667",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Digital Footprint Eraser - Mobile View"
    }
  ],
  "shortcuts": [
    {
      "name": "Cookie Cleanup",
      "short_name": "Cookies",
      "description": "Quick cookie and tracker cleanup",
      "url": "/?action=cookies",
      "icons": [
        {
          "src": "assets/images/shortcut-cookies.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Privacy Scan",
      "short_name": "Scan",
      "description": "Analyze digital footprint",
      "url": "/?action=scan",
      "icons": [
        {
          "src": "assets/images/shortcut-scan.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Data Brokers",
      "short_name": "Brokers",
      "description": "Remove from data brokers",
      "url": "/?action=brokers",
      "icons": [
        {
          "src": "assets/images/shortcut-brokers.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "related_applications": [
    {
      "platform": "chrome_web_store",
      "url": "https://chrome.google.com/webstore/detail/digital-footprint-eraser",
      "id": "digital-footprint-eraser-extension"
    }
  ],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "handle_links": "preferred",
  "capture_links": "existing-client-navigate",
  "protocol_handlers": [
    {
      "protocol": "web+privacy",
      "url": "/?protocol=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "text/csv": [".csv"],
        "application/json": [".json"],
        "text/plain": [".txt"]
      },
      "launch_type": "single-client"
    }
  ]
}