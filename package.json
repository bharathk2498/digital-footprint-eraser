{
  "name": "digital-footprint-eraser",
  "version": "1.0.0",
  "description": "Enterprise-grade digital footprint elimination with AI-powered threat detection, quantum-level security, and comprehensive family protection",
  "main": "index.html",
  "scripts": {
    "start": "http-server . -p 8080 -c-1",
    "dev": "http-server . -p 3000 -c-1 --cors",
    "build": "npm run build:prod",
    "build:prod": "npm run minify && npm run optimize",
    "minify": "terser advanced-security-complete.js -o dist/advanced-security.min.js --compress --mangle",
    "optimize": "imagemin 'assets/**/*.{jpg,png,svg}' --out-dir=dist/assets",
    "test": "npm run test:security && npm run test:compliance && npm run test:ai",
    "test:security": "jest tests/security --coverage",
    "test:compliance": "jest tests/compliance --coverage", 
    "test:ai": "jest tests/ai-security --coverage",
    "test:quantum": "jest tests/quantum --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .js,.html --fix",
    "lint:security": "eslint . --ext .js,.html --config .eslintrc.security.js",
    "audit": "npm audit --audit-level=high",
    "audit:security": "npm audit --audit-level=moderate",
    "docker:build": "docker build -t dfe/enterprise:latest .",
    "docker:run": "docker run -p 8080:80 dfe/enterprise:latest",
    "docker:security-scan": "docker run --rm -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy image dfe/enterprise:latest",
    "k8s:deploy": "kubectl apply -f k8s-deployment/",
    "k8s:destroy": "kubectl delete -f k8s-deployment/",
    "compliance:check": "node scripts/compliance-check.js",
    "security:scan": "node scripts/security-scan.js",
    "quantum:validate": "node scripts/quantum-validation.js",
    "ai:test": "node scripts/ai-security-test.js",
    "docs:generate": "jsdoc -c jsdoc.conf.json",
    "docs:serve": "http-server docs -p 8081",
    "deploy:staging": "npm run build && aws s3 sync dist/ s3://dfe-staging-bucket/",
    "deploy:production": "npm run build && aws s3 sync dist/ s3://dfe-production-bucket/",
    "certificate:generate": "openssl req -x509 -newkey rsa:4096 -keyout key.pem -out cert.pem -days 365 -nodes",
    "certificate:quantum": "node scripts/generate-quantum-cert.js"
  },
  "keywords": [
    "cybersecurity",
    "privacy",
    "digital-footprint",
    "threat-intelligence", 
    "quantum-security",
    "ai-protection",
    "family-safety",
    "enterprise-security",
    "zero-trust",
    "compliance",
    "GDPR",
    "HIPAA",
    "FISMA",
    "SOX",
    "post-quantum-cryptography",
    "behavioral-analysis",
    "osint-defense",
    "data-broker-removal"
  ],
  "author": {
    "name": "Bharath Kumar Byru",
    "email": "bharathk9339@gmail.com",
    "url": "https://github.com/bharathk2498"
  },
  "license": "SEE LICENSE IN LICENSE-ENTERPRISE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/bharathk2498/digital-footprint-eraser.git"
  },
  "bugs": {
    "url": "https://github.com/bharathk2498/digital-footprint-eraser/issues",
    "email": "security@digital-footprint-eraser.com"
  },
  "homepage": "https://bharathk2498.github.io/digital-footprint-eraser",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "cors": "^2.8.5",
    "rate-limiter-flexible": "^3.0.8",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "crypto": "^1.0.1",
    "node-forge": "^1.3.1",
    "axios": "^1.5.0",
    "winston": "^3.10.0",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "jest": "^29.6.2",
    "playwright": "^1.37.1",
    "eslint": "^8.47.0",
    "eslint-plugin-security": "^1.7.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "terser": "^5.19.2",
    "imagemin": "^8.0.1",
    "imagemin-mozjpeg": "^10.0.0",
    "imagemin-pngquant": "^9.0.2",
    "http-server": "^14.1.1",
    "jsdoc": "^4.0.2",
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "@types/node": "^20.5.0",
    "typescript": "^5.1.6",
    "supertest": "^6.3.3",
    "sinon": "^15.2.0",
    "nyc": "^15.1.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.3"
  },
  "optionalDependencies": {
    "sharp": "^0.32.4",
    "canvas": "^2.11.2"
  },
  "peerDependencies": {
    "kubernetes-client": "^9.0.0",
    "aws-sdk": "^2.1450.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "jest": {
    "testEnvironment": "jsdom",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "**/*.js",
      "!node_modules/**",
      "!coverage/**",
      "!dist/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/tests/**/*.spec.js"
    ]
  },
  "eslintConfig": {
    "extends": [
      "airbnb-base",
      "plugin:security/recommended"
    ],
    "env": {
      "browser": true,
      "es6": true,
      "node": true,
      "jest": true
    },
    "rules": {
      "no-console": "warn",
      "security/detect-object-injection": "error",
      "security/detect-non-literal-regexp": "error",
      "security/detect-unsafe-regex": "error"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged && npm run test:security",
      "pre-push": "npm run audit:security"
    }
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "git add"
    ],
    "*.{json,md}": [
      "prettier --write",
      "git add"
    ]
  },
  "nyc": {
    "reporter": [
      "text",
      "html",
      "lcov"
    ],
    "exclude": [
      "tests/**",
      "coverage/**",
      "node_modules/**"
    ]
  },
  "config": {
    "security": {
      "level": "military-grade",
      "quantum-ready": true,
      "ai-enhanced": true,
      "compliance-frameworks": [
        "GDPR",
        "HIPAA", 
        "SOX",
        "FISMA",
        "CCPA",
        "PIPEDA",
        "LGPD",
        "ISO27001",
        "SOC2",
        "NIST"
      ]
    }
  },
  "funding": {
    "type": "enterprise",
    "url": "https://digital-footprint-eraser.com/enterprise"
  },
  "files": [
    "index.html",
    "advanced-security-enhanced.html",
    "advanced-security-complete.js",
    "docs/",
    "dist/",
    "LICENSE-ENTERPRISE.md",
    "SECURITY.md",
    "COMPLIANCE.md"
  ],
  "publishConfig": {
    "registry": "https://npm.digital-footprint-eraser.com",
    "access": "restricted"
  },
  "enterprise": {
    "support": {
      "email": "enterprise@digital-footprint-eraser.com",
      "phone": "+1-800-PRIVACY",
      "sla": "24/7",
      "response-time": "< 15 minutes"
    },
    "certifications": [
      "ISO27001",
      "SOC2-Type-II",
      "FedRAMP-Moderate",
